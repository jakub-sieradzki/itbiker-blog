---
import siteConfig from "@config";
import ThemeToggle from "./ThemeToggle.astro";

const Navigation = [
  { name: "Główna", href: "/" },
  { name: "Blog", href: "/blog" },
  { name: "Poradniki", href: "/poradniki" },
  { name: "O mnie", href: "/about" },
];

const currentPath = Astro.url.pathname;
---

<header
  class="mx-auto mt-4 flex max-w-5xl items-center justify-between rounded-lg bg-white/70 px-6 py-4 shadow-sm backdrop-blur-xs transition-colors duration-200 dark:bg-zinc-950/60"
>
  <a
    href="/"
    class="text-xl w-fit text-nowrap font-bold tracking-tight text-[#1f2937] transition-colors duration-200 hover:text-red-500 dark:text-neutral-100 dark:hover:text-red-700"
  >
    {siteConfig.siteTitle}
  </a>

  <nav class="flex w-fit mx-3 overflow-auto text-nowrap items-center gap-1">
    {
      Navigation.map((item) => {
        const isActive =
          currentPath === item.href ||
          (item.href !== "/" && currentPath.startsWith(item.href));

        return (
          <a
            href={item.href}
            class={`rounded-md px-4 py-2 text-sm font-medium transition-all duration-200 ${
              isActive
                ? "bg-red-100 font-semibold text-red-400 dark:bg-red-950/60 dark:text-red-400"
                : "text-neutral-400 hover:bg-red-100/60 hover:text-red-400 active:scale-95 dark:text-neutral-400 dark:hover:bg-red-950/30 dark:hover:text-red-400"
            }`}
          >
            {item.name}
          </a>
        );
      })
    }
  </nav>

  <ThemeToggle />
</header>
