---
import siteConfig from "@config";
const currentYear = new Date().getFullYear();
---

<footer
  class="mx-auto mb-10 flex max-w-5xl items-center justify-center rounded-lg bg-white/70 backdrop-blur-xs px-8 py-6 shadow-sm transition-colors duration-200 dark:bg-zinc-950/60"
>
  <p class="text-center text-neutral-500 dark:text-neutral-400">
    © {currentYear}&nbsp;
    <a
      href={siteConfig.authorUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="font-semibold text-neutral-800 transition-colors duration-200 hover:text-red-500 dark:text-neutral-200 dark:hover:text-red-500"
    >
      {siteConfig.author}
    </a>
    . LwG! 🏍️
  </p>
</footer>